{
  "name": "paylink-monad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One invoice link. A person pays it with a wallet; an AP agent pays the same URL over x402. USDC on Monad.",
  "scripts": {
    "fork": "hardhat node --fork https://rpc.monad.xyz --port 8545",
    "test": "vitest run",
