    "demo": "tsx scripts/demo.ts",
    "probe": "tsx scripts/facilitator-probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "hardhat": "^2.29.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.4",
    "vitest": "^5.0.3"
  }
}
